# Copy this file to .env and fill in your own values. Never commit .env.

# App
APP_NAME=AIMeals
APP_VERSION=1.0.0
DEBUG=true
HOST=127.0.0.1
PORT=8000

# Security (generate with: python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI provider
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514

# Transactional email (OTP and password reset)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Database, e.g. postgresql+psycopg2://user:password@localhost:5432/aimeals
DATABASE_URL=

# Logging and uploads
LOG_LEVEL=INFO
MAX_UPLOAD_SIZE_MB=20
UPLOAD_FOLDER=app/uploads

# RevenueCat webhook bearer secret (leave blank to reject all webhook calls)
REVENUECAT_WEBHOOK_SECRET=
